{
	# Plain HTTP on 8080: put a reverse proxy / TLS terminator in front for HTTPS.
	auto_https off
	admin off
	frankenphp
}

:8080 {
	root * /app/public
	encode zstd gzip

	# Never serve dotfiles or the app source, even if something is misplaced under public/.
	@forbidden path /.* /storage/* /vendor/*
	respond @forbidden 404

	php_server
}
