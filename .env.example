# LabMan configuration. Everything here is optional: the container works with no .env at all.
# Copy to .env only for local development. NEVER commit a real .env.

APP_NAME=LabMan
APP_ENV=production
APP_DEBUG=false
# Leave APP_KEY empty in Docker: the entrypoint generates one into the /data volume on first start.
APP_KEY=
APP_URL=http://localhost:8080

# Optional: shared secret the first-run wizard must be given (protects a freshly exposed install).
LABMAN_SETUP_TOKEN=

# Behind a reverse proxy: comma separated proxy IPs/CIDRs (or * to trust any), so HTTPS/host are detected.
LABMAN_TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database: SQLite by default (stored in the data volume).
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
# Or PostgreSQL / MySQL:
# DB_CONNECTION=pgsql
# DB_HOST=db.example.com
# DB_PORT=5432
# DB_DATABASE=labman
# DB_USERNAME=labman
# DB_PASSWORD=change-me

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Laravel's storage directory lives in the data volume.
LARAVEL_STORAGE_PATH=/data/storage
